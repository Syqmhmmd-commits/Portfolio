/* ============================================
   VARIABEL WARNA
   ============================================ */
:root {
  --bg: #0a0e14;
  --bg-soft: #121821;
  --card: #161d28;
  --border: #232b38;
  --text: #e6edf3;
  --muted: #8b98a9;
  --accent: #00d9a3;
  --accent-2: #2ea8ff;
  --nav-h: 65px;
}

/* ============================================
   RESET & DASAR
   ============================================ */
* { margin: 0; padding: 0; box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.6;
  overflow-x: hidden;
}

/* Section offset biar gak ketutup navbar */
section[id] { scroll-margin-top: 80px; }

/* ============================================
   BACKGROUND GRID + GLOW
   ============================================ */
body::before {
  content: "";
  position: fixed;
  inset: 0;
  background-image:
    linear-gradient(rgba(0, 217, 163, 0.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0, 217, 163, 0.04) 1px, transparent 1px);
  background-size: 40px 40px;
  z-index: -2;
}

body::after {
  content: "";
  position: fixed;
  top: -30%;
  left: 50%;
  transform: translateX(-50%);
  width: 800px;
  height: 800px;
  background: radial-gradient(circle, rgba(0, 217, 163, 0.12), transparent 60%);
  z-index: -1;
  pointer-events: none;
}

/* ============================================
   NAVBAR
   ============================================ */
nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  height: var(--nav-h);
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 6vw;
  background: rgba(10, 14, 20, 0.75);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
  z-index: 100;
}

.logo {
  font-family: 'Consolas', 'JetBrains Mono', 'Fira Code', monospace;
  font-weight: 700;
  font-size: 1.1rem;
  color: var(--accent);
}

.logo span { color: var(--muted); }

nav ul {
  display: flex;
  gap: 28px;
  list-style: none;
}

nav a {
  color: var(--muted);
  text-decoration: none;
  font-size: 0.92rem;
  transition: color 0.2s;
  position: relative;
  padding: 4px 0;
}

nav a:hover,
nav a.active {
  color: var(--accent);
}

nav a.active::after {
  content: "";
  position: absolute;
  bottom: -4px; left: 0; right: 0;
  height: 2px;
  background: var(--accent);
  border-radius: 2px;
}

/* ===== Hamburger ===== */
.nav-toggle {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: transparent;
  border: none;
  cursor: pointer;
  padding: 8px;
}

.nav-toggle span {
  display: block;
  width: 24px;
  height: 2px;
  background: var(--text);
  border-radius: 2px;
  transition: transform 0.3s, opacity 0.3s;
}

.nav-toggle.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
.nav-toggle.open span:nth-child(2) { opacity: 0; }
.nav-toggle.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

/* ============================================
   SECTION UMUM
   ============================================ */
section {
  padding: 100px 6vw;
  max-width: 1200px;
  margin: 0 auto;
}

/* ============================================
   HERO
   ============================================ */
#hero {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-top: 120px;
}

.terminal-tag {
  display: inline-block;
  font-family: 'Consolas', 'JetBrains Mono', monospace;
  font-size: 0.85rem;
  color: var(--accent);
  background: rgba(0, 217, 163, 0.08);
  border: 1px solid rgba(0, 217, 163, 0.25);
  padding: 6px 14px;
  border-radius: 6px;
  margin-bottom: 24px;
  width: fit-content;
}

#hero h1 {
  font-size: clamp(2.2rem, 6vw, 4rem);
  line-height: 1.15;
  font-weight: 800;
  margin-bottom: 20px;
  letter-spacing: -1px;
}

#hero h1 .grad {
  background: linear-gradient(90deg, var(--accent), var(--accent-2));
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

#hero p {
  font-size: 1.1rem;
  color: var(--muted);
  max-width: 620px;
  margin-bottom: 36px;
}

/* ============================================
   BUTTON
   ============================================ */
.btns {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
}

.btn {
  padding: 13px 26px;
  border-radius: 8px;
  text-decoration: none;
  font-weight: 600;
  font-size: 0.95rem;
  transition: all 0.25s;
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.btn-primary {
  background: var(--accent);
  color: #04211a;
}

.btn-primary:hover {
  transform: translateY(-3px);
  box-shadow: 0 10px 30px rgba(0, 217, 163, 0.3);
}

.btn-ghost {
  background: transparent;
  border: 1px solid var(--border);
  color: var(--text);
}

.btn-ghost:hover {
  border-color: var(--accent);
  color: var(--accent);
  transform: translateY(-3px);
}

/* ============================================
   SECTION HEADING
   ============================================ */
.sec-head { margin-bottom: 48px; }

.sec-head .kicker {
  font-family: 'Consolas', 'JetBrains Mono', monospace;
  color: var(--accent);
  font-size: 0.85rem;
  margin-bottom: 8px;
  display: block;
}

.sec-head h2 {
  font-size: clamp(1.6rem, 4vw, 2.4rem);
  font-weight: 800;
  letter-spacing: -0.5px;
}

.sec-head h2::after {
  content: "";
  display: block;
  width: 60px;
  height: 3px;
  background: linear-gradient(90deg, var(--accent), transparent);
  margin-top: 14px;
  border-radius: 2px;
}

/* ============================================
   SKILLS
   ============================================ */
.skills-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 20px;
}

.skill-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 26px;
  transition: all 0.3s;
}

.skill-card:hover {
  border-color: rgba(0, 217, 163, 0.4);
  transform: translateY(-5px);
}

.skill-card h3 {
  font-size: 1.05rem;
  margin-bottom: 14px;
  color: var(--accent);
  font-family: 'Consolas', 'JetBrains Mono', monospace;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.tag {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid var(--border);
  padding: 5px 12px;
  border-radius: 20px;
  font-size: 0.8rem;
  color: var(--muted);
}

/* ============================================
   PROJECTS
   ============================================ */
.projects-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 22px;
}

.project {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 28px;
  display: flex;
  flex-direction: column;
  transition: all 0.3s;
  position: relative;
  overflow: hidden;
}

.project::before {
  content: "";
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3px;
  background: linear-gradient(90deg, var(--accent), var(--accent-2));
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.4s;
}

.project:hover::before { transform: scaleX(1); }

.project:hover {
  border-color: rgba(0, 217, 163, 0.35);
  transform: translateY(-6px);
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
}

.project-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16px;
}

.folder-icon {
  color: var(--accent);
  font-size: 1.6rem;
  line-height: 1;
}

.project h3 {
  font-size: 1.15rem;
  margin-bottom: 10px;
  word-break: break-word;
}

.project h3 a {
  color: var(--text);
  text-decoration: none;
  transition: color 0.2s;
}

.project h3 a:hover { color: var(--accent); }

.project p {
  color: var(--muted);
  font-size: 0.92rem;
  flex-grow: 1;
  margin-bottom: 18px;
}

.project .tags { margin-bottom: 20px; }

.repo-link {
  font-family: 'Consolas', 'JetBrains Mono', monospace;
  font-size: 0.82rem;
  color: var(--accent);
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  transition: gap 0.2s;
}

.repo-link:hover { gap: 10px; }

.badge {
  font-size: 0.68rem;
  padding: 3px 9px;
  border-radius: 6px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.badge-hot {
  background: rgba(255, 90, 90, 0.15);
  color: #ff7a7a;
  border: 1px solid rgba(255, 90, 90, 0.3);
}

/* ============================================
   ABOUT
   ============================================ */
.about-wrap {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  align-items: center;
}

.about-wrap p {
  color: var(--muted);
  margin-bottom: 16px;
}

.stat-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

.stat {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 22px;
  text-align: center;
}

.stat .num {
  font-size: 1.8rem;
  font-weight: 800;
  color: var(--accent);
  font-family: 'Consolas', 'JetBrains Mono', monospace;
}

.stat .lbl {
  font-size: 0.82rem;
  color: var(--muted);
  margin-top: 4px;
}

/* ============================================
   CONTACT
   ============================================ */
#contact { text-align: center; }

#contact .sec-head {
  display: inline-block;
  text-align: left;
}

#contact p {
  color: var(--muted);
  max-width: 500px;
  margin: 0 auto 32px;
}

#contact .btns { justify-content: center; }

/* ============================================
   FOOTER
   ============================================ */
footer {
  text-align: center;
  padding: 40px 6vw;
  border-top: 1px solid var(--border);
  color: var(--muted);
  font-size: 0.85rem;
}

footer .logo {
  margin-bottom: 8px;
  display: inline-block;
}

/* ============================================
   ANIMASI REVEAL
   ============================================ */
.reveal {
  opacity: 0;
  transform: translateY(30px);
  transition: opacity 0.7s ease, transform 0.7s ease;
  will-change: opacity, transform;
}

.reveal.show {
  opacity: 1;
  transform: translateY(0);
}

/* ============================================
   PREFERS REDUCED MOTION
   ============================================ */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
  .reveal { opacity: 1; transform: none; }
}

/* ============================================
   RESPONSIVE
   ============================================ */
@media (max-width: 768px) {
  .nav-toggle { display: flex; }

  nav ul {
    position: fixed;
    top: var(--nav-h);
    left: 0; right: 0;
    flex-direction: column;
    gap: 0;
    background: rgba(10, 14, 20, 0.98);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    padding: 8px 6vw 20px;
    transform: translateY(-120%);
    transition: transform 0.35s ease;
    pointer-events: none;
  }

  nav ul.open {
    transform: translateY(0);
    pointer-events: auto;
  }

  nav ul li { width: 100%; }

  nav ul a {
    display: block;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
    font-size: 1rem;
  }

  nav ul li:last-child a { border-bottom: none; }

  .about-wrap { grid-template-columns: 1fr; }

  section { padding: 70px 5vw; }
}